  m_Script: {fileID: 11500000, guid: bea460737b0922b45b8a5cbb9b1a0d61, type: 3}
  m_Name: NarrativaFinal
  m_EditorClassIdentifier: Assembly-CSharp::DialogData
  talkScript:
  - texto: "Ap\xF3s tantos desafios, Noah finalmente encontrou os fragmentos que
      procurava."
  - texto: "Cada fragmento revelou um pouco de seu passado, trazendo de volta lembran\xE7as
      que pareciam perdidas para sempre."
  - texto: "Mas algumas jornadas n\xE3o terminam quando encontramos as respostas."
  - texto: Elas permanecem conosco, nas escolhas que fizemos e nos caminhos que percorremos.
